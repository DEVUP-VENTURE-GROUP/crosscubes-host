# CrossCubes API: production (EC2). Fill in on the server as backend/.env; never commit the filled-in file.
# The API refuses to start with placeholder or short secrets, wildcard CORS or half-set S3.

NODE_ENV=production
PORT=4400
HOST=127.0.0.1
APP_NAME=CrossCubes
BRAND_NAME=CrossCubes
APP_KEY=crosscubes
PUBLIC_API_URL=https://api.crosscubes.com
# Secret admin path; must equal NEXT_PUBLIC_ADMIN_SLUG on the admin site
ADMIN_SLUG=

MONGO_URI=
MONGO_MAX_POOL=50
REDIS_URL=
REDIS_PREFIX=crosscubes

# Each one `openssl rand -hex 32`, all different, never reused from CatoDrive
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PASSWORD_PEPPER=
VISITOR_HASH_SALT=

CORS_ORIGINS=https://crosscubes.com,https://www.crosscubes.com,https://partners.crosscubes.com,https://hub.crosscubes.com,https://admin.crosscubes.com
WEB_URL=https://www.crosscubes.com
PARTNER_WEB_URL=https://partners.crosscubes.com
# Include the hub panel's secret path
HUB_WEB_URL=https://hub.crosscubes.com/
# 1 with Cloudflare DNS-only (grey cloud), 2 once the orange cloud proxy is on
TRUST_PROXY_HOPS=1

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HQ Admin

# Shared CatoDrive Stripe account (live keys). The webhook secret comes from the CrossCubes endpoint, not CatoDrive's.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_IDENTITY_READ_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=crosscubes-media
S3_PUBLIC_BASE_URL=

# Email and texts run on CatoDrive's accounts for now
EMAIL_FROM=CrossCubes <no-reply@catodrive.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_API_URL=
EMAIL_API_KEY=
SMS_ACCOUNT_SID=
SMS_API_KEY_SID=
SMS_API_KEY_SECRET=
SMS_AUTH_TOKEN=
SMS_FROM=
FCM_SERVICE_ACCOUNT_BASE64=

GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
OPENROUTER_API_KEY=
VINAUDIT_API_KEY=
SENTRY_DSN=
RELEASE=
SUPPORT_EMAIL=support@crosscubes.com
COMPANY_ADDRESS=

# Wheelbase account the cars are insured under (digits). Optional: Admin -> Car Insurance can set it instead.
WHEELBASE_DEALER_ID=
# Shared secret the Zapier zap sends in the X-CrossCubes-Secret header (64 hex chars: openssl rand -hex 32).
WHEELBASE_WEBHOOK_SECRET=
