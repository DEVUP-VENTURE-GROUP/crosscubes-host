# CrossCubes API: local development. Copy to backend/.env and run `npm run dev` (port 4400).
# Real keys are never committed; ask the owner for the shared test values if you need Stripe or email locally.

NODE_ENV=development
PORT=4400
APP_NAME=CrossCubes
BRAND_NAME=CrossCubes
# Tags every Stripe payment so CrossCubes and CatoDrive (same Stripe account) never mix. Never change it.
APP_KEY=crosscubes
PUBLIC_API_URL=http://localhost:4400
ADMIN_SLUG=admin

# Database and cache: a local MongoDB replica set and Redis, e.g.
#   docker run -d --name cc-mongo -p 27017:27017 mongo:7 --replSet rs0 && docker exec cc-mongo mongosh --eval "rs.initiate()"
#   docker run -d --name cc-redis -p 6379:6379 redis:7
MONGO_URI=mongodb://127.0.0.1:27017/crosscubes_dev?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=crosscubes

# Any 32+ random characters for local use: `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PASSWORD_PEPPER=

# The four local sites
CORS_ORIGINS=http://localhost:4000,http://localhost:4005,http://localhost:4010,http://localhost:4030
WEB_URL=http://localhost:4000
PARTNER_WEB_URL=http://localhost:4010
HUB_WEB_URL=http://localhost:4030
TRUST_PROXY_HOPS=0

# First HQ login, created at start-up if it does not exist
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=
ADMIN_NAME=HQ Admin

# Payments: Stripe TEST keys only (sk_test_ / pk_test_). Left empty, a built-in mock takes payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_IDENTITY_READ_KEY=

# Optional locally: left empty, files stay on disk and emails/texts/pushes are logged instead of sent.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_ACCOUNT_SID=
SMS_API_KEY_SID=
SMS_API_KEY_SECRET=
SMS_AUTH_TOKEN=
SMS_FROM=
FCM_SERVICE_ACCOUNT_BASE64=
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
OPENROUTER_API_KEY=
VINAUDIT_API_KEY=
SENTRY_DSN=
SUPPORT_EMAIL=support@crosscubes.com
COMPANY_ADDRESS=
