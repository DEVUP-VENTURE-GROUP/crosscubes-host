# CrossCubes Partner app: local development. Copy to .env.local; use your computer's LAN address so a phone can reach the API.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4400/api/v1
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:4000
EXPO_PUBLIC_PARTNER_URL=http://192.168.1.10:4010
EXPO_PUBLIC_LAUNCH_MODE=asset_partners_only
EXPO_PUBLIC_API_TIMEOUT_MS=15000
